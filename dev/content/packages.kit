<section id="packages">
  <h1>Popular packages</h1>
  <img src="img/global/Ellipse11.svg" alt="green icon" />

  <div id="packages-button-container">
    <button id="left"><i class="fa-solid fa-chevron-left"></i></button>
    <button id="right"><i class="fa-solid fa-chevron-right"></i></button>
  </div>
  <ul id="package-card-container">
    <li class="package-card">
      <img src="img/packages/card1.jpg" alt="first card" class="img-scaler" />
      <p>The basic package to start your promotion.</p>

      <ul>
        <li><img src="img/packages/user1.jpg" alt="first user" /></li>
        <li><img src="img/packages/user3.jpg" alt="third user" /></li>
        <li><img src="img/packages/user2.jpg" alt="second user" /></li>
      </ul>
      <h4>200k+ users</h4>
      <h3>$89.00</h3>
    </li>

    <li class="selected" class="package-card">
      <img src="img/packages/card3.jpg" alt="second card" class="img-scaler" />
      <p>The standard package to grow your business</p>

      <ul>
        <li><img src="img/packages/user5.jpg" alt="first user" /></li>
        <li><img src="img/packages/user3.jpg" alt="third user" /></li>
        <li><img src="img/packages/user4.jpg" alt="second user" /></li>
      </ul>
      <h4>140k+ users</h4>
      <h3>$109.00</h3>
    </li>

    <li class="package-card">
      <img src="img/packages/card2.jpg" alt="third card" class="img-scaler" />
      <p>The premium package to boost your promotion</p>

      <ul>
        <li><img src="img/packages/user5.jpg" alt="first user" /></li>
        <li><img src="img/packages/user3.jpg" alt="third user" /></li>
        <li><img src="img/packages/user4.jpg" alt="second user" /></li>
      </ul>
      <h4>99k+ users</h4>
      <h3>$149.00</h3>
    </li>
  </ul>
</section>
