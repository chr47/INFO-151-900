<section id="packages">
  <div id="top-content">
    <h1 class="section-title">Popular packages</h1>

    <div id="packages-button-container">
      <button id="left"><i class="fa-solid fa-chevron-left"></i></button>
      <button id="right"><i class="fa-solid fa-chevron-right"></i></button>
    </div>
  </div>

  <ul id="package-card-container">
    <li class="package-card" id="card-1">
      <div class="package-card-image"></div>
      <p>The basic package to start your promotion.</p>

      <div class="package-info">
        <ul class="user-icons">
          <li class="user1"></li>
          <li class="user3"></li>
          <li class="user2"></li>
        </ul>
        <h4>200k+ users</h4>
        <h3>$89.00</h3>
      </div>
    </li>

    <li class="package-card selected" id="card-2">
      <div class="package-card-image"></div>
      <p>The standard package to grow your business</p>

      <div class="package-info">
        <ul class="user-icons">
          <li class="user5"></li>
          <li class="user3"></li>
          <li class="user4"></li>
        </ul>
        <h4>140k+ users</h4>
        <h3>$109.00</h3>
      </div>
    </li>

    <li class="package-card" id="card-3">
      <div class="package-card-image"></div>
      <p>The premium package to boost your promotion</p>

      <div class="package-info">
        <ul class="user-icons">
          <li class="user5"></li>
          <li class="user3"></li>
          <li class="user4"></li>
        </ul>
        <h4>99k+ users</h4>
        <h3>$149.00</h3>
      </div>
    </li>
  </ul>
</section>
